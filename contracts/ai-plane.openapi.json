{
  "components": {
    "schemas": {
      "CheckClaimRequest": {
        "properties": {
          "claim": {
            "maxLength": 8000,
            "minLength": 1,
            "title": "Claim",
            "type": "string"
          },
          "concept_id": {
            "minLength": 1,
            "title": "Concept Id",
            "type": "string"
          },
          "item_id": {
            "minLength": 1,
            "title": "Item Id",
            "type": "string"
          },
          "learner_id": {
            "minLength": 1,
            "title": "Learner Id",
            "type": "string"
          }
        },
        "required": [
          "item_id",
          "claim",
          "learner_id",
          "concept_id"
        ],
        "title": "CheckClaimRequest",
        "type": "object"
      },
      "CheckClaimResponse": {
        "description": "**Everything the tutor is ever told.** Three words, and possibly a key.\n\nA ``correct_answer`` field must never be added here, however convenient it would be for the\n\"reveal the answer at the end of the session\" feature somebody will eventually ask for. If that\nfeature is ever built, it must be built somewhere the tutor's context cannot reach.",
        "properties": {
          "misconception": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Misconception"
          },
          "outcome": {
            "$ref": "#/components/schemas/ClaimOutcome"
          },
          "usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Usd"
          }
        },
        "required": [
          "outcome"
        ],
        "title": "CheckClaimResponse",
        "type": "object"
      },
      "ClaimOutcome": {
        "description": "The whole vocabulary. Three words, and no room in any of them for a sentence.",
        "enum": [
          "correct",
          "partial",
          "wrong"
        ],
        "title": "ClaimOutcome",
        "type": "string"
      },
      "DimensionSpec": {
        "properties": {
          "auto_flag_at_or_below": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Auto Flag At Or Below"
          },
          "auto_flag_misconception": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Auto Flag Misconception"
          },
          "bands": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Bands",
            "type": "object"
          },
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "probe": {
            "title": "Probe",
            "type": "string"
          },
          "weight": {
            "exclusiveMinimum": 0.0,
            "maximum": 1.0,
            "title": "Weight",
            "type": "number"
          }
        },
        "required": [
          "id",
          "weight",
          "probe",
          "bands"
        ],
        "title": "DimensionSpec",
        "type": "object"
      },
      "EvidenceType": {
        "description": "The six kinds of proof (I-2). Mirrors ``Praxis.Shared.EvidenceType`` exactly.\n\n**They are not equal, and the difference is the product.**",
        "enum": [
          "recall",
          "apply",
          "explain",
          "build",
          "critique",
          "predict"
        ],
        "title": "EvidenceType",
        "type": "string"
      },
      "GenerateItemRequest": {
        "properties": {
          "already_seen": {
            "items": {
              "type": "string"
            },
            "title": "Already Seen",
            "type": "array"
          },
          "concept_id": {
            "minLength": 1,
            "title": "Concept Id",
            "type": "string"
          },
          "concept_summary": {
            "minLength": 1,
            "title": "Concept Summary",
            "type": "string"
          },
          "difficulty": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Difficulty",
            "type": "number"
          },
          "evidence_type": {
            "$ref": "#/components/schemas/EvidenceType"
          },
          "learner_id": {
            "minLength": 1,
            "title": "Learner Id",
            "type": "string"
          }
        },
        "required": [
          "concept_id",
          "concept_summary",
          "evidence_type",
          "difficulty",
          "learner_id"
        ],
        "title": "GenerateItemRequest",
        "type": "object"
      },
      "GradeOutcome": {
        "enum": [
          "passed",
          "failed",
          "pending"
        ],
        "title": "GradeOutcome",
        "type": "string"
      },
      "GradeRequest": {
        "properties": {
          "concept_id": {
            "minLength": 1,
            "title": "Concept Id",
            "type": "string"
          },
          "learner_id": {
            "minLength": 1,
            "title": "Learner Id",
            "type": "string"
          },
          "response": {
            "maxLength": 40000,
            "minLength": 1,
            "title": "Response",
            "type": "string"
          },
          "rubric": {
            "$ref": "#/components/schemas/RubricSpec"
          }
        },
        "required": [
          "response",
          "rubric",
          "learner_id",
          "concept_id"
        ],
        "title": "GradeRequest",
        "type": "object"
      },
      "GradeResponse": {
        "description": "**`pending` is a real outcome and the core must handle it as one** (R-1).\n\nIt is not a slow `passed`. The .NET side writes it as `PENDING` evidence, which cannot move\nmastery, and a human decides. There is no field here that lets the caller resolve it themselves.",
        "properties": {
          "escalated_to_adjudicator": {
            "title": "Escalated To Adjudicator",
            "type": "boolean"
          },
          "escalated_to_human": {
            "title": "Escalated To Human",
            "type": "boolean"
          },
          "judges_consulted": {
            "title": "Judges Consulted",
            "type": "integer"
          },
          "misconceptions": {
            "items": {
              "type": "string"
            },
            "title": "Misconceptions",
            "type": "array"
          },
          "outcome": {
            "$ref": "#/components/schemas/GradeOutcome"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Usd"
          }
        },
        "required": [
          "outcome",
          "reason",
          "judges_consulted",
          "escalated_to_adjudicator",
          "escalated_to_human"
        ],
        "title": "GradeResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HardFailSpec": {
        "properties": {
          "cap": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Cap",
            "type": "number"
          },
          "misconception": {
            "title": "Misconception",
            "type": "string"
          },
          "pattern": {
            "title": "Pattern",
            "type": "string"
          }
        },
        "required": [
          "pattern",
          "misconception",
          "cap"
        ],
        "title": "HardFailSpec",
        "type": "object"
      },
      "ItemResponse": {
        "description": "**Everything the core, the tutor and the learner ever see of an item.**\n\nThere is no `answer` field, and there must never be one. The answer exists \u2014 it went to the\noracle's store the moment the item was made \u2014 and the only thing that ever comes back out of it\nis one of three words (M5.3).",
        "properties": {
          "concept_id": {
            "title": "Concept Id",
            "type": "string"
          },
          "difficulty": {
            "title": "Difficulty",
            "type": "number"
          },
          "evidence_type": {
            "$ref": "#/components/schemas/EvidenceType"
          },
          "fingerprint": {
            "title": "Fingerprint",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "stem": {
            "title": "Stem",
            "type": "string"
          }
        },
        "required": [
          "id",
          "concept_id",
          "evidence_type",
          "stem",
          "difficulty",
          "fingerprint"
        ],
        "title": "ItemResponse",
        "type": "object"
      },
      "RubricSpec": {
        "description": "The rubric travels *to* the grader on every call, because the AI plane remembers nothing.\n\nIt is answer-adjacent (a band description is, in effect, the answer), which is exactly why it\ngoes to the **grader** and never to the **tutor**, and why the tutor's endpoint takes no rubric.",
        "properties": {
          "audience": {
            "title": "Audience",
            "type": "string"
          },
          "concept_id": {
            "title": "Concept Id",
            "type": "string"
          },
          "dimensions": {
            "items": {
              "$ref": "#/components/schemas/DimensionSpec"
            },
            "minItems": 1,
            "title": "Dimensions",
            "type": "array"
          },
          "hard_fails": {
            "items": {
              "$ref": "#/components/schemas/HardFailSpec"
            },
            "title": "Hard Fails",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "min_length": {
            "default": 40,
            "title": "Min Length",
            "type": "integer"
          },
          "pass_score": {
            "default": 0.75,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Pass Score",
            "type": "number"
          }
        },
        "required": [
          "id",
          "concept_id",
          "audience",
          "dimensions"
        ],
        "title": "RubricSpec",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Stateless. It does not hold the answer.",
    "title": "PRAXIS AI plane",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/assessment/grade": {
      "post": {
        "operationId": "grade_assessment_grade_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GradeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GradeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Grade",
        "tags": [
          "assessment"
        ]
      }
    },
    "/assessment/items": {
      "post": {
        "operationId": "generate_item_assessment_items_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateItemRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Generate Item",
        "tags": [
          "assessment"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Liveness, and an honest account of what this process can actually do.\n\n``model_configured`` is a boolean and will never be anything else. It says *whether* a key is\npresent, never what it is \u2014 and it deliberately does not claim the key **works**. Proving that\nwould mean spending a learner's money on a real call, and a health check that quietly bills\nsomeone is not a health check.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/oracle/check-claim": {
      "post": {
        "operationId": "check_claim_oracle_check_claim_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckClaimRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckClaimResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Check Claim",
        "tags": [
          "oracle"
        ]
      }
    }
  }
}
