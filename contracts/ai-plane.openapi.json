{
  "components": {
    "schemas": {
      "CheckClaimRequest": {
        "properties": {
          "claim": {
            "default": "",
            "maxLength": 8000,
            "title": "Claim",
            "type": "string"
          },
          "concept_id": {
            "minLength": 1,
            "title": "Concept Id",
            "type": "string"
          },
          "item_id": {
            "minLength": 1,
            "title": "Item Id",
            "type": "string"
          },
          "learner_id": {
            "minLength": 1,
            "title": "Learner Id",
            "type": "string"
          },
          "selected_option": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Selected Option"
          }
        },
        "required": [
          "item_id",
          "learner_id",
          "concept_id"
        ],
        "title": "CheckClaimRequest",
        "type": "object"
      },
      "CheckClaimResponse": {
        "description": "**Everything the tutor is ever told.** Three words, and possibly a key.\n\nA ``correct_answer`` field must never be added here, however convenient it would be for the\n\"reveal the answer at the end of the session\" feature somebody will eventually ask for. If that\nfeature is ever built, it must be built somewhere the tutor's context cannot reach.",
        "properties": {
          "misconception": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Misconception"
          },
          "outcome": {
            "$ref": "#/components/schemas/ClaimOutcome"
          },
          "usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Usd"
          }
        },
        "required": [
          "outcome"
        ],
        "title": "CheckClaimResponse",
        "type": "object"
      },
      "ClaimOutcome": {
        "description": "The whole vocabulary. Three words, and no room in any of them for a sentence.",
        "enum": [
          "correct",
          "partial",
          "wrong"
        ],
        "title": "ClaimOutcome",
        "type": "string"
      },
      "EvidenceType": {
        "description": "The six kinds of proof (I-2). Mirrors ``Praxis.Shared.EvidenceType`` exactly.\n\n**They are not equal, and the difference is the product.**",
        "enum": [
          "recall",
          "apply",
          "explain",
          "build",
          "critique",
          "predict"
        ],
        "title": "EvidenceType",
        "type": "string"
      },
      "GenerateItemRequest": {
        "properties": {
          "already_seen": {
            "items": {
              "type": "string"
            },
            "title": "Already Seen",
            "type": "array"
          },
          "concept_id": {
            "minLength": 1,
            "title": "Concept Id",
            "type": "string"
          },
          "concept_summary": {
            "minLength": 1,
            "title": "Concept Summary",
            "type": "string"
          },
          "difficulty": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Difficulty",
            "type": "number"
          },
          "evidence_type": {
            "$ref": "#/components/schemas/EvidenceType"
          },
          "item_format": {
            "$ref": "#/components/schemas/ItemFormat",
            "default": "prose"
          },
          "known_misconceptions": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Known Misconceptions",
            "type": "object"
          },
          "learner_id": {
            "minLength": 1,
            "title": "Learner Id",
            "type": "string"
          }
        },
        "required": [
          "concept_id",
          "concept_summary",
          "evidence_type",
          "difficulty",
          "learner_id"
        ],
        "title": "GenerateItemRequest",
        "type": "object"
      },
      "GradeByConceptRequest": {
        "properties": {
          "concept_id": {
            "minLength": 1,
            "title": "Concept Id",
            "type": "string"
          },
          "learner_id": {
            "minLength": 1,
            "title": "Learner Id",
            "type": "string"
          },
          "response": {
            "maxLength": 40000,
            "minLength": 1,
            "title": "Response",
            "type": "string"
          }
        },
        "required": [
          "response",
          "learner_id",
          "concept_id"
        ],
        "title": "GradeByConceptRequest",
        "type": "object"
      },
      "GradeOutcome": {
        "enum": [
          "passed",
          "failed",
          "pending"
        ],
        "title": "GradeOutcome",
        "type": "string"
      },
      "GradeResponse": {
        "description": "**`pending` is a real outcome and the core must handle it as one** (R-1).\n\nIt is not a slow `passed`. The .NET side writes it as `PENDING` evidence, which cannot move\nmastery, and a human decides. There is no field here that lets the caller resolve it themselves.",
        "properties": {
          "escalated_to_adjudicator": {
            "title": "Escalated To Adjudicator",
            "type": "boolean"
          },
          "escalated_to_human": {
            "title": "Escalated To Human",
            "type": "boolean"
          },
          "judges_consulted": {
            "title": "Judges Consulted",
            "type": "integer"
          },
          "misconceptions": {
            "items": {
              "type": "string"
            },
            "title": "Misconceptions",
            "type": "array"
          },
          "outcome": {
            "$ref": "#/components/schemas/GradeOutcome"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Usd"
          }
        },
        "required": [
          "outcome",
          "reason",
          "judges_consulted",
          "escalated_to_adjudicator",
          "escalated_to_human"
        ],
        "title": "GradeResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HintRung": {
        "description": "Mirrors ``Praxis.Modules.Kernel.Events.HintRung`` exactly (M6.2).\n\nFive rungs, and **there is no sixth**. CANON lists an `L5 FULL_REVEAL` and marks it *\"in LEARN\nmode this rung does not exist\"* \u2014 so it does not exist here either. Not gated, not flagged,\nabsent. There is no enum value to reach for, so there is no code path to write.",
        "enum": [
          0,
          1,
          2,
          3,
          4
        ],
        "title": "HintRung",
        "type": "integer"
      },
      "ItemFormat": {
        "description": "How an item is answered, and therefore how it is marked.\n\n``MULTIPLE_CHOICE`` is marked by comparing two integers \u2014 no model, no judgement, no cost. It\nis the only marking in PRAXIS whose verdict is a *fact* rather than an opinion.",
        "enum": [
          "prose",
          "multiple_choice"
        ],
        "title": "ItemFormat",
        "type": "string"
      },
      "ItemResponse": {
        "description": "**Everything the core, the tutor and the learner ever see of an item.**\n\nThere is no `answer` field, and there must never be one. The answer exists \u2014 it went to the\noracle's store the moment the item was made \u2014 and the only thing that ever comes back out of it\nis one of three words (M5.3).",
        "properties": {
          "concept_id": {
            "title": "Concept Id",
            "type": "string"
          },
          "difficulty": {
            "title": "Difficulty",
            "type": "number"
          },
          "evidence_type": {
            "$ref": "#/components/schemas/EvidenceType"
          },
          "fingerprint": {
            "title": "Fingerprint",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "options": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Options"
          },
          "passage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Passage"
          },
          "stem": {
            "title": "Stem",
            "type": "string"
          },
          "targets_misconception": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Targets Misconception"
          }
        },
        "required": [
          "id",
          "concept_id",
          "evidence_type",
          "stem",
          "difficulty",
          "fingerprint"
        ],
        "title": "ItemResponse",
        "type": "object"
      },
      "TurnSpec": {
        "description": "One utterance. The learner's words are **data** \u2014 they land here and nowhere else.",
        "properties": {
          "said": {
            "maxLength": 20000,
            "minLength": 1,
            "title": "Said",
            "type": "string"
          },
          "who": {
            "pattern": "^(learner|tutor)$",
            "title": "Who",
            "type": "string"
          }
        },
        "required": [
          "who",
          "said"
        ],
        "title": "TurnSpec",
        "type": "object"
      },
      "TutorTurnRequest": {
        "description": "**Everything the tutor is ever given.**\n\nNo ``answer``. No ``rubric`` (its band descriptions *are* the answer \u2014 M5.4). No ``expected``.\nA field that does not exist on the wire cannot be populated by a caller having a bad day.",
        "properties": {
          "budget_remaining": {
            "minimum": 0.0,
            "title": "Budget Remaining",
            "type": "integer"
          },
          "concept_id": {
            "minLength": 1,
            "title": "Concept Id",
            "type": "string"
          },
          "concept_summary": {
            "minLength": 1,
            "title": "Concept Summary",
            "type": "string"
          },
          "item_stem": {
            "minLength": 1,
            "title": "Item Stem",
            "type": "string"
          },
          "known_misconceptions": {
            "items": {
              "type": "string"
            },
            "title": "Known Misconceptions",
            "type": "array"
          },
          "learner_id": {
            "minLength": 1,
            "title": "Learner Id",
            "type": "string"
          },
          "passage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Passage"
          },
          "rung": {
            "$ref": "#/components/schemas/HintRung"
          },
          "transcript": {
            "items": {
              "$ref": "#/components/schemas/TurnSpec"
            },
            "title": "Transcript",
            "type": "array"
          }
        },
        "required": [
          "concept_summary",
          "item_stem",
          "rung",
          "budget_remaining",
          "learner_id",
          "concept_id"
        ],
        "title": "TutorTurnRequest",
        "type": "object"
      },
      "TutorTurnResponse": {
        "properties": {
          "text": {
            "title": "Text",
            "type": "string"
          },
          "usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Usd"
          }
        },
        "required": [
          "text"
        ],
        "title": "TutorTurnResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Stateless. It does not hold the answer.",
    "title": "PRAXIS AI plane",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/assessment/grade-by-concept": {
      "post": {
        "operationId": "grade_by_concept_assessment_grade_by_concept_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GradeByConceptRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GradeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Grade By Concept",
        "tags": [
          "assessment"
        ]
      }
    },
    "/assessment/items": {
      "post": {
        "operationId": "generate_item_assessment_items_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateItemRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Generate Item",
        "tags": [
          "assessment"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Liveness, and an honest account of what this process can actually do.\n\n``model_configured`` is a boolean and will never be anything else. It says *whether* a key is\npresent, never what it is \u2014 and it deliberately does not claim the key **works**. Proving that\nwould mean spending a learner's money on a real call, and a health check that quietly bills\nsomeone is not a health check.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/oracle/check-claim": {
      "post": {
        "operationId": "check_claim_oracle_check_claim_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckClaimRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckClaimResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Check Claim",
        "tags": [
          "oracle"
        ]
      }
    },
    "/tutor/turn": {
      "post": {
        "operationId": "turn_tutor_turn_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TutorTurnRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TutorTurnResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Turn",
        "tags": [
          "tutor"
        ]
      }
    },
    "/tutor/turn/stream": {
      "post": {
        "description": "The same turn, streamed token by token (SSE).\n\n**A stream has no schema, and that is the whole danger of it.**\n\nEvery other guarantee in PRAXIS is enforced by a type \u2014 the verdict has no field for a sentence,\nthe item has no field for an answer, the contract has no field for a key. A stream has no fields\nat all. It is a hose of free text pointed at a learner's browser, and nothing downstream can\ninspect what comes out of it.\n\nSo the guarantee here cannot come from the shape of the *output*. It comes from the shape of the\n**input**: the context is built by the same ``build_context`` as the non-streaming turn, it has\nno field an answer could sit in, and a model streaming its whole context verbatim therefore\nstreams no answer.\n\nThat is the only thing standing here \u2014 which is exactly why the jailbreak suite is **re-run\nagainst the stream** rather than assumed to carry over from the buffered path.",
        "operationId": "turn_stream_tutor_turn_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TutorTurnRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Turn Stream",
        "tags": [
          "tutor"
        ]
      }
    }
  }
}
