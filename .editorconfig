root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets}]
indent_size = 4

[*.{json,yaml,yml,ts,tsx,js,jsx,css,md}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:error

# CA1716: "Shared" collides with a VB reserved word. Praxis.Shared is the name the
# architecture standard mandates, and nothing here will ever be consumed from VB.
dotnet_diagnostic.CA1716.severity = none

# CA1000: static factories on generic types. `Result<T>.NotFound(...)` and `ApiResponse<T>.Ok(...)`
# are the exact shape the architecture standard mandates, and they are the whole ergonomic point
# of the type. The rule's concern — that callers must name the type argument — is what we want.
dotnet_diagnostic.CA1000.severity = none

[**/*Controller.cs]
# CA1822: a controller action that touches no instance state can be static. Ours never touch
# instance state — that IS the pattern (bind, resolve the handler, map the Result). MVC requires
# them to be instance methods anyway.
dotnet_diagnostic.CA1822.severity = none

[**/Migrations/*.cs]
# EF scaffolds these. We hand-edit only the Sql() blocks; the rest is generated, and holding
# generated code to hand-written style rules just means editing it back after every scaffold.
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.IDE0300.severity = none
dotnet_diagnostic.IDE0161.severity = none
csharp_style_namespace_declarations = block_scoped:silent

[tests/**/*.cs]
# Test names are sentences. `Explain_evidence_can_never_cross_the_hold_threshold` is the
# point of the test; PascalCase would bury it.
dotnet_diagnostic.CA1707.severity = none

# CA1822: controller actions are instance methods by convention, even when they touch no
# instance state — which, given thin controllers, is always.
dotnet_diagnostic.CA1822.severity = none
