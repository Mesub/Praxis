# Copy to ai/.env — which is gitignored, and stays that way.
#
# Never commit a key. Never print a key. The settings type is a SecretStr precisely so that a stray
# print, a crash repr or an over-helpful structured log cannot leak it by accident.

ANTHROPIC_API_KEY=sk-ant-your-key-here

ENVIRONMENT=development

# Opus-class for compilation, grading and synthesis. Sonnet-class for tutor turns and item
# generation — the tutor speaks far more often than it judges.
MODEL_HEAVY=claude-opus-4-8
MODEL_FAST=claude-sonnet-5

LOG_LEVEL=INFO

# JSON lines for machines; readable lines for a human watching a terminal.
LOG_JSON=false
